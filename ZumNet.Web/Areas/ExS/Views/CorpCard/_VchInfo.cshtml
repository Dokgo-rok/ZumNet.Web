@using System.Collections;
@using System.Data;
@using System.Text;
@using System.Text.RegularExpressions;
@using Newtonsoft.Json;
@using Newtonsoft.Json.Linq;
@using ZumNet.Framework.Util;
@{
    string sTitle = "전표신청내역";
}
@functions{
    /// <summary>
    /// 전표신청내역
    /// </summary>
    /// <param name="post"></param>
    /// <param name="ds"></param>
    /// <returns></returns>
    private string ViewInfo(JObject post, DataSet ds)
    {
        bool bAdmin = post["operator"].ToString() == "Y" ? true : false;

        StringBuilder sb = new StringBuilder();
        if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
        {
            DataRow row = ds.Tables[0].Rows[0];

            int iVchUser = StringHelper.SafeInt(row["applicantid"]);

            sb.Append("<div class=\"modal-body p-2\">"); //modal-body

            sb.Append("<h6 class=\"mb-1 ml-1\"><i class=\"fe-chevron-right mr-1\">공급자정보</i></h6>"); //공급자정보
            sb.Append("<table class=\"table table-bordered table-sm\">");
            sb.Append("<colspan><col style=\"width:15%\" /><col style=\"width:35%\" /><col style=\"width:15%\" /><col style=\"width:35%\" /></colspan>");

            //성명, 사번
            sb.AppendFormat("<tr><th class=\"bg-light\">성명</th><td><div class=\"p-1\">{0}</div></td>", row["supplier"].ToString());
            sb.AppendFormat("<th class=\"bg-light\">사번</th><td><div class=\"p-1\">{0}</div></td>", row["supplierempno"].ToString());
            sb.Append("</tr>");

            //부서, AP일자
            sb.AppendFormat("<tr><th class=\"bg-light\">부서</th><td><div class=\"p-1\">{0}</div></td>", row["supplierdept"].ToString());
            sb.AppendFormat("<th class=\"bg-light\">AP일자</th><td><div class=\"p-1\">{0}</div></td>", CvtDate(row["apdate"].ToString()));
            sb.Append("</tr>");
            sb.Append("</table>");

            sb.Append("<h6 class=\"mb-1 ml-1\"><i class=\"fe-chevron-right mr-1\">결재/연동 상태</i></h6>"); //결재/연동 상태
            sb.Append("<table class=\"table table-bordered table-sm\">");
            sb.Append("<colspan><col style=\"width:15%\" /><col style=\"width:35%\" /><col style=\"width:15%\" /><col style=\"width:35%\" /></colspan>");

            //결재문서
            sb.AppendFormat("<tr><th class=\"bg-light\">문서명</th><td><div class=\"p-1\"><a class=\"z-lnk-navy\" href=\"javascript:\" onclick=\"_zw.fn.openEAFormSimple('{0}');\">{1}</a></div></td>", row["pilink"].ToString(), row["DocName"].ToString());
            sb.AppendFormat("<th class=\"bg-light\">진행상태</th><td><div class=\"p-1\">{0}</div></td>", StrApvState(row["pistate"].ToString()));
            sb.Append("</tr>");

            //연동
            sb.AppendFormat("<tr><th class=\"bg-light\">연동상태</th><td><div class=\"p-1\">{0}</div></td>", StrIFState(row["ifstate"].ToString()));
            sb.AppendFormat("<th class=\"bg-light\">연동일자</th><td><div class=\"p-1\">{0}</div></td>", DateHelper.CheckDateTime(row["ifdate"].ToString()));
            sb.Append("</tr>");
            if (row["ifstate"].ToString() == "8") sb.AppendFormat("<tr class=\"table-danger\"><th class=\"bg-light\">오류메시지</th><td colspan=\"3\"><div class=\"p-1\">{0}</div></td>", row["ifmsg"].ToString());
            sb.Append("</tr>");

            sb.AppendFormat("<tr><th class=\"bg-light\">ERP처리</th><td><div class=\"p-1\">{0}</div></td>", StrIFState(row["reqstatus"].ToString()));
            sb.AppendFormat("<th class=\"bg-light\">작성일자</th><td><div class=\"p-1\">{0}</div></td>", DateHelper.CheckDateTime(row["credate"].ToString()));
            sb.Append("</tr>");
            sb.Append("</table>");

            sb.Append("<h6 class=\"mb-1 ml-1\"><i class=\"fe-chevron-right mr-1\">지출내역</i></h6>"); //지출내역
            sb.Append("<table class=\"table table-bordered table-sm\">");
            sb.Append("<colspan><col style=\"width:15%\" /><col style=\"width:35%\" /><col style=\"width:15%\" /><col style=\"width:35%\" /></colspan>");

            //경비구분, 계정명
            sb.AppendFormat("<tr><th class=\"bg-light\">경비구분</th><td><div class=\"p-1\">{0}</div></td>", row["expensetype"].ToString());
            sb.AppendFormat("<th class=\"bg-light\">계정명</th><td><div class=\"p-1\">{0}</div></td>", row["acntnm"].ToString());
            sb.Append("</tr>");

            //거래구분, 사용일자
            sb.AppendFormat("<tr><th class=\"bg-light\">거래구분</th><td><div class=\"p-1\">{0}</div></td>", StrPurchaseFlag(row["purchaseflag"].ToString()));
            sb.AppendFormat("<th class=\"bg-light\">사용일자</th><td><div class=\"p-1\">{0}</div></td>", CvtDate(row["aquidate"].ToString()));
            sb.Append("</tr>");

            //카드번호, 승인번호
            sb.AppendFormat("<tr><th class=\"bg-light\">카드번호</th><td><div class=\"p-1\">{0}</div></td>", StrCardNum(row["cardnum"].ToString()));
            sb.AppendFormat("<th class=\"bg-light\">승인번호</th><td><div class=\"p-1\">{0}</div></td>", row["ackno"].ToString());
            sb.Append("</tr>");

            //가맹점명, 사업자번호
            sb.AppendFormat("<tr><th class=\"bg-light\">가맹점명</th><td><div class=\"p-1\">{0}</div></td>", row["mercname"].ToString());
            sb.AppendFormat("<th class=\"bg-light\">사업자번호</th><td><div class=\"p-1\">{0}</div></td>", StrSocNum(row["mercsocno"].ToString()));
            sb.Append("</tr>");

            //과세구분, 승인금액, 인정금액
            sb.AppendFormat("<tr><th class=\"bg-light\">과세구분</th><td><div class=\"p-1\">{0}</div></td>", row["merctaxkind"].ToString());
            sb.AppendFormat("<th class=\"bg-light\">승인금액</th><td><div class=\"p-1\">{0}</div></td>", StringHelper.CvtCurrency(row["ackamt"].ToString(), 2));
            sb.Append("</tr>");
            sb.AppendFormat("<tr><th class=\"bg-light\">공급가액</th><td><div class=\"p-1\">{0}</div></td>", StringHelper.CvtCurrency(row["valsupply"].ToString(), 2));
            sb.AppendFormat("<th class=\"bg-light\">부가세</th><td><div class=\"p-1\">{0}</div></td>", StringHelper.CvtCurrency(row["vat"].ToString(), 2));
            sb.Append("</tr>");
            sb.AppendFormat("<tr><th class=\"bg-light\">통화</th><td><div class=\"p-1\">{0}</div></td>", row["currency"].ToString());
            sb.AppendFormat("<th class=\"bg-light\">인정금액</th><td><div class=\"p-1\">{0}</div></td>", StringHelper.CvtCurrency(row["reqamt"].ToString(), 2));
            sb.Append("</tr>");
            sb.AppendFormat("<tr><th class=\"bg-light\">공급가액</th><td><div class=\"p-1\">{0}</div></td>", StringHelper.CvtCurrency(row["reqvalsupply"].ToString(), 2));
            sb.AppendFormat("<th class=\"bg-light\">부가세</th><td><div class=\"p-1\">{0}</div></td>", StringHelper.CvtCurrency(row["reqvat"].ToString(), 2));
            sb.Append("</tr>");

            //세금구분, 세목
            sb.AppendFormat("<tr><th class=\"bg-light\">세금구분</th><td><div class=\"p-1\">{0}</div></td>", row["taxrate"].ToString());
            sb.AppendFormat("<th class=\"bg-light\">세목</th><td><div class=\"p-1\">{0}</div></td>", row["taxexpl"].ToString());
            sb.Append("</tr>");

            //불공제사유, 적요
            sb.AppendFormat("<tr><th class=\"bg-light\">불공제사유</th><td><div class=\"p-1\">{0}</div></td>", row["taxnondedu"].ToString());
            sb.AppendFormat("<th class=\"bg-light\">적요</th><td><div class=\"p-1\">{0}</div></td>", row["etc"].ToString());
            sb.Append("</tr>");
            sb.Append("</table>");

            if (row["acntcls"].ToString() != "")
            {
                sb.Append("<h6 class=\"mb-1 ml-1\"><i class=\"fe-chevron-right mr-1\">세부정보</i></h6>"); //세부정보
                sb.Append("<table class=\"table table-bordered table-sm mb-0\">");
                sb.Append("<colspan><col style=\"width:15%\" /><col style=\"width:35%\" /><col style=\"width:15%\" /><col style=\"width:35%\" /></colspan>");

                if (row["acntcls"].ToString() == "A1")
                {
                    sb.AppendFormat("<tr><th class=\"bg-light\">회의일자</th><td><div class=\"p-1\">{0}</div></td>", row["detailinfo1"].ToString());
                    sb.AppendFormat("<th class=\"bg-light\">회의장소</th><td><div class=\"p-1\">{0}</div></td></tr>", row["detailinfo2"].ToString());
                    sb.AppendFormat("<tr><th class=\"bg-light\">작성부서/작성자</th><td><div class=\"p-1\">{0}</div></td>", row["detailinfo3"].ToString());
                    sb.AppendFormat("<th class=\"bg-light\">회의참석자</th><td><div class=\"p-1\">{0}</div></td></tr>", row["detailinfo4"].ToString());
                    sb.AppendFormat("<tr><th class=\"bg-light\">회의목적</th><td colspan=\"3\"><div class=\"p-1\">{0}</div></td></tr>", row["detailinfo5"].ToString());
                }
                else if (row["acntcls"].ToString() == "A2")
                {
                    sb.AppendFormat("<tr><th class=\"bg-light\">국내/해외</th><td><div class=\"p-1\">{0}</div></td>", row["detailinfo1"].ToString());
                    sb.AppendFormat("<th class=\"bg-light\">접대일자</th><td><div class=\"p-1\">{0}</div></td></tr>", row["detailinfo2"].ToString());
                    sb.AppendFormat("<tr><th class=\"bg-light\">작성부서/작성자</th><td><div class=\"p-1\">{0}</div></td>", row["detailinfo3"].ToString());
                    sb.AppendFormat("<th class=\"bg-light\">당사 참석인명</th><td><div class=\"p-1\">{0}</div></td></tr>", row["detailinfo4"].ToString());
                    sb.AppendFormat("<tr><th class=\"bg-light\">거래처명</th><td><div class=\"p-1\">{0}</div></td>", row["detailinfo5"].ToString());
                    sb.AppendFormat("<th class=\"bg-light\">접대자</th><td><div class=\"p-1\">{0}</div></td></tr>", row["detailinfo6"].ToString());
                    sb.AppendFormat("<tr><th class=\"bg-light\">접대장소</th><td colspan=\"3\"><div class=\"p-1\">{0}</div></td></tr>", row["detailinfo7"].ToString());
                    sb.AppendFormat("<tr><th class=\"bg-light\">접대목적</th><td colspan=\"3\"><div class=\"p-1\">{0}</div></td></tr>", row["detailinfo8"].ToString());
                }
                else if (row["acntcls"].ToString() == "A3")
                {
                    sb.AppendFormat("<tr><th class=\"bg-light\">고정자산</th><td colspan=\"3\"><div class=\"p-1\">{0}</div></td></tr>", row["detailinfo1"].ToString());
                }
                else if (row["acntcls"].ToString() == "A4")
                {
                    sb.AppendFormat("<tr><th class=\"bg-light\">S-DATE</th><td><div class=\"p-1\">{0}</div></td>", row["detailinfo1"].ToString());
                    sb.AppendFormat("<th class=\"bg-light\">E-DATE</th><td><div class=\"p-1\">{0}</div></td></tr>", row["detailinfo2"].ToString());
                }
                else if (row["acntcls"].ToString() == "B1")
                {
                    sb.AppendFormat("<tr><th class=\"bg-light\">차량번호</th><td><div class=\"p-1\">{0}</div></td>", row["detailinfo1"].ToString());
                    sb.AppendFormat("<th class=\"bg-light\">주유일자</th><td><div class=\"p-1\">{0}</div></td></tr>", row["detailinfo2"].ToString());
                }
                else if (row["acntcls"].ToString() == "B2")
                {
                    sb.AppendFormat("<tr><th class=\"bg-light\">차량번호</th><td><div class=\"p-1\">{0}</div></td>", row["detailinfo1"].ToString());
                    sb.AppendFormat("<th class=\"bg-light\">정비일자</th><td><div class=\"p-1\">{0}</div></td></tr>", row["detailinfo2"].ToString());
                }
                else if (row["acntcls"].ToString() == "B3")
                {
                    sb.AppendFormat("<tr><th class=\"bg-light\">차량번호</th><td colspan=\"3\"><div class=\"p-1\">{0}</div></td></tr>", row["detailinfo1"].ToString());
                }
                else if (row["acntcls"].ToString() == "C1")
                {
                    sb.AppendFormat("<tr><th class=\"bg-light\">개인/법인</th><td><div class=\"p-1\">{0}</div></td>", row["detailinfo1"].ToString());
                    sb.AppendFormat("<th class=\"bg-light\">Phone No.</th><td><div class=\"p-1\">{0}</div></td></tr>", row["detailinfo2"].ToString());
                }
                else if (row["acntcls"].ToString() == "D1")
                {
                    sb.AppendFormat("<tr><th class=\"bg-light\">Project ID</th><td colspan=\"3\"><div class=\"p-1\">{0}</div></td></tr>", row["detailinfo1"].ToString());
                }
                sb.Append("</table>");
            }
            //숨은 필드


            sb.Append("</div>"); //modal-body
            sb.Append("<div class=\"modal-footer\">");
            sb.AppendFormat("<button type=\"button\" class=\"btn btn-default\" data-dismiss=\"modal\">{0}</button>", Resources.Global.Close);
            sb.Append("</div>");
        }
        else
        {
            sb.Append("<div class=\"modal-body text-center p-0\">"); //modal-body

            sb.AppendFormat("<p class=\"py-5 h5\">{0}</p>", Resources.Global.NoItemShow);

            sb.Append("</div>"); //modal-body

            sb.Append("<div class=\"modal-footer\">");
            sb.AppendFormat("<button type=\"button\" class=\"btn btn-default\" data-dismiss=\"modal\">{0}</button>", Resources.Global.Close);
            sb.Append("</div>");
        }
        return sb.ToString();
    }

    #region [유틸]
    private string StrPurchaseFlag(string flag)
    {
        string rt = "";

        if (flag == "03") rt = "매입";
        else if (flag == "04") rt = "취소";
        else rt = flag;

        return rt;
    }

    private string StrCardNum(string num)
    {
        // 숫자 이외의 문자 제거
        string cleaned = Regex.Replace(num, @"\s|-", "");
        // 4자리마다 하이픈 삽입
        return Regex.Replace(cleaned, @"(.{4})(?=.)", "$1-");
    }

    private string StrSocNum(string num)
    {
        return string.Format("{0:###-##-#####}", long.Parse(num));
    }

    private string CvtDate(string d)
    {
        if (d != "") return d.Substring(0, 4) + "-" + d.Substring(4, 2) + "-" + d.Substring(6, 2);
        else return "";
    }
    private string CvtTime(string t)
    {
        if (t != "") return t.Substring(0, 2) + ":" + t.Substring(2, 2) + ":" + t.Substring(4, 2);
        else return "";
    }

    private string StrApvState(string state)
    {
        string rt = "";

        if (state == "I") rt = "처리중";
        else if (state == "Y") rt = "완료";
        else if (state == "R") rt = "반려";
        else if (state == "C") rt = "취소";
        return rt;
    }

    private string StrIFState(string state)
    {
        string rt = "";

        if (state == "0") rt = "대기";
        else if (state == "1") rt = "처리중";
        else if (state == "7") rt = "완료";
        else if (state == "8") rt = "오류";
        else if (state == "A") rt = "승인";
        else if (state == "R") rt = "반려";
        else if (state == "D") rt = "전표생성";
        return rt;
    }
    #endregion
}
<div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content bg-white z-list" style="box-shadow: 0px 5px 15px rgba(0,0,0,0.5)">
        <div class="modal-header py-2">
            <h5 class="modal-title">@sTitle</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">×</span>
            </button>
        </div>
        @Html.Raw(ViewInfo(ViewBag.JPost, ViewBag.VchInfo))
    </div>
</div>