        @if (ViewBag.JPost["M"].ToString() == "new")
        {
            @Html.Raw(NewCard(ViewBag.JPost))
        }
        else if (ViewBag.JPost["M"].ToString() == "edit")
        {
            @Html.Raw(EditCard(ViewBag.JPost, ViewBag.CardInfo))
        }
