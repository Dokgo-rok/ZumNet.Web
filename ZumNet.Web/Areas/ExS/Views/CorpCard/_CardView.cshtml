    /// <summary>
    /// 카드 조회 (연동카드, 직접입력 카드)
    /// </summary>
    /// <param name="post"></param>
    /// <param name="ds"></param>
    /// <returns></returns>
    private string ViewCard(JObject post, DataSet ds)
    {
        //현대카드연동, 직접입력
        //결재문서 연결 : 사용자 연결 안된 경우
        //사용자, 소지자 연결 : 결재문서 연결 안된 경우
        //관리자만 신규, 수정 권한
        //문서보안 권한자 : 카드사용열람권한자 추가 가능
        bool bAdmin = post["operator"].ToString() == "Y" ? true : false;
        bool bAckAuth = StringHelper.HasAcl(post["acl"].ToString(), "S");

        StringBuilder sb = new StringBuilder();
        if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
        {
            DataRow row = ds.Tables[0].Rows[0];

            int iLinkDoc = StringHelper.SafeInt(row["pilink"]); //연결된 결재문서
            bool bInterface = row["ifdate"].ToString() == "" ? false : true; //연동 문서 여부

            string strFld01 = "";

            sb.Append("<div class=\"modal-body p-2\">"); //modal-body
            sb.Append("<table class=\"table table-bordered table-sm mb-0\">");
            sb.Append("<colspan><col style=\"width:15%\" /><col style=\"width:35%\" /><col style=\"width:15%\" /><col style=\"width:35%\" /></colspan>");

            if (bAdmin && bInterface)
                sb.AppendFormat("<tr><th class=\"bg-light\">구분</th><td><input type=\"text\" class=\"form-control\" name=\"RegChangeData\" data-field=\"{0}\" maxlength=\"20\" value=\"{1}\"></td>", "membertype", row["membertype"].ToString());
            else
                sb.AppendFormat("<tr><th class=\"bg-light\">구분</th><td><div class=\"p-1\">{0}</div></td>", row["membertype"].ToString());

            sb.AppendFormat("<th class=\"bg-light\">카드사</th><td><div class=\"p-1\">{0}</div></td>", StrCardCorp(row["cardcorp"].ToString()));
            sb.Append("</tr>");

            sb.AppendFormat("<tr><th class=\"bg-light\">카드번호</th><td><div class=\"p-1\">{0}</div></td>", StrCardNum(row["cardnum"].ToString()));
            sb.AppendFormat("<th class=\"bg-light\">유효기간</th><td><div class=\"p-1\">{0}</div></td>", StrCardPeriod(row["cardprid"].ToString()));
            sb.Append("</tr>");

            if (bAdmin && bInterface)
                sb.AppendFormat("<tr><th class=\"bg-light\">카드종류</th><td><input type=\"text\" class=\"form-control\" name=\"RegChangeData\" data-field=\"{0}\" maxlength=\"20\" value=\"{1}\"></td>", "cardtype", row["cardtype"].ToString());
            else
                sb.AppendFormat("<tr><th class=\"bg-light\">카드종류</th><td><div class=\"p-1\">{0}</div></td>", row["cardtype"].ToString());

            sb.AppendFormat("<th class=\"bg-light\">한도(천원)</th><td><div class=\"p-1\">{0}</div></td>", StrCardLimitAmt(row["limitamt"].ToString()));
            sb.Append("</tr>");

            sb.AppendFormat("<tr><th class=\"bg-light\">상태</th><td><div class=\"p-1\">{0}</div></td>", StrCardState(row["cardstat"].ToString(), "external.cc_cardstate"));
