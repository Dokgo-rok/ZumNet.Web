    #region [유틸]
    private string StrCardNum(string num)
    {
        // 숫자 이외의 문자 제거
        string cleaned = Regex.Replace(num, @"\s|-", "");
        // 4자리마다 하이픈 삽입
        return Regex.Replace(cleaned, @"(.{4})(?=.)", "$1-");
    }

    private string StrCardPeriod(string period)
    {
        if (period == null || period == "") return "";
        else
        {
            if (period.Length == 4) return period.Substring(0, 2) + "/" + period.Substring(2, 2);
            else if (period.Length == 6) return period.Substring(2, 2) + "/" + period.Substring(4, 2);
            else return period;
        }
    }

    private string StrCardLimitAmt(string amt)
    {
        if (amt == null || amt == "") return "";
        else
        {
            if (decimal.TryParse(amt, out decimal result))
            {
                return String.Format($"{result / 1000:n0}");
            }
            else return amt;
        }
    }

    private string CvtDate(string d)
    {
        if (d != "") return d.Substring(0, 4) + "-" + d.Substring(4, 2) + "-" + d.Substring(6, 2);
        else return "";
    }

    private string CvtTime(string t)
    {
        if (t != "") return t.Substring(0, 2) + ":" + t.Substring(2, 2) + ":" + t.Substring(4, 2);
        else return "";
    }

    private string StrCardCorp(string card)
    {
        foreach (object[] o in ViewBag.CodeTable["external.cc_cardcorp"])
        {
            if (o[3].ToString() == card)
                return o[4].ToString();

        }
        return card;
    }

    private string StrCardState(string state, string codeTable)
    {
        string rt = "";
        //external.cc_cardstate, external.cc_reqkind

        foreach (object[] o in ViewBag.CodeTable[codeTable])
        {
            if (o[3].ToString() == state)
                return o[4].ToString().Length > 3 ? o[4].ToString().Substring(0, 2) : o[4].ToString();
        }

        //if (isu == "" || isu == "0") rt = "신청";
        //else if (state == "1") rt = "정상";
        //else if (state == "3" || state == "5") rt = "정지";
        //else if (state == "7") rt = "취소";
        //else if (state == "9") rt = "교체";

        return rt;
    }
    #endregion
}
